+            space: current.space(),
+            resource: current.resource(),
+            writer_epoch: current.writer_epoch(),
+            sequence: local.snapshot.sequence,
+            policy_head: local.snapshot.policy_head,
+            revocation_root: local.revocation_root,
+        };
