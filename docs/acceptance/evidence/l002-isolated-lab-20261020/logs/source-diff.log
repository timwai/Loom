diff --git a/crates/loom-core/examples/l002_lan_lab.rs b/crates/loom-core/examples/l002_lan_lab.rs
new file mode 100644
index 0000000..69ce28b
--- /dev/null
+++ b/crates/loom-core/examples/l002_lan_lab.rs
@@ -0,0 +1,253 @@
+//! Explicit loopback-only L-002 lab. All enrolled keys are public fixtures.
+#[path = "support/l002_fixture.rs"]
+mod fixture;
+use fixture::*;
+use loom_core::lan_read::*;
+use loom_store::witness_append::*;
+use loom_transport::secure_channel::*;
+use std::{
+    fs::File,
+    io::{self, Write},
+};
+use tokio::{
+    io::{AsyncReadExt, AsyncWriteExt},
+    net::{TcpListener, TcpStream},
+    time::{Duration, timeout},
+};
+
+#[tokio::main(flavor = "current_thread")]
+async fn main() -> LabResult<()> {
+    let args: Vec<String> = std::env::args().collect();
+    let mode = args.get(1).ok_or("mode required")?.as_str();
+    let directory = std::path::Path::new(args.get(2).ok_or("directory required")?);
+    if mode == "init" {
+        Fixture::enroll(directory)?;
+        println!("{{\"enrolled\":true,\"fixture_keys\":true}}");
+        return Ok(());
+    }
+    let f = Fixture::load(directory)?;
+    let a = f.peer("a");
+    let b = f.peer("b");
+    match mode {
+        "grant" | "revoke" => {
+            let signed = f.commit_all(&a, mode == "grant");
+            println!(
+                "{{\"sequence\":{},\"allow\":{}}}",
+                signed.request.expected_generation + 1,
+                mode == "grant"
+            );
+        }
+        "prepare" => {
+            let history = f
+                .log("policy")
+                .history()
+                .map_err(|e| format!("history {e:?}"))?;
+            let signed = f.signed(&history, &a, args.get(3).is_none_or(|a| a == "grant"));
+            std::fs::write(directory.join("pending.append"), signed.encode())?;
+            println!(
+                "{{\"prepared_sequence\":{}}}",
+                signed.request.expected_generation + 1
+            );
+        }
+        "append" => {
+            let name = args.get(3).ok_or("log name required")?;
+            if !["policy", "witness-a", "witness-b"].contains(&name.as_str()) {
+                return Err("invalid log".into());
+            }
+            let cut = args.get(4).map(String::as_str).unwrap_or("");
+            let signed = SignedAppend::decode(&std::fs::read(directory.join("pending.append"))?)
+                .map_err(|e| format!("decode {e:?}"))?;
+            let history = f
+                .log(name)
+                .append_lab(signed, now(), |point| {
+                    if point == cut {
+                        println!("{{\"cut\":\"{point}\"}}");
+                        io::stdout().flush().unwrap();
+                        let mut line = String::new();
+                        io::stdin().read_line(&mut line).unwrap();
+                    }
+                })
+                .map_err(|e| format!("append {e:?}"))?;
+            println!("{{\"sequence\":{}}}", history.high_water().sequence);
+        }
+        "status" => {
+            for name in ["policy", "witness-a", "witness-b"] {
+                let history = f
+                    .log(name)
+                    .history()
+                    .map_err(|e| format!("history {e:?}"))?;
+                println!(
+                    "{{\"log\":\"{name}\",\"sequence\":{},\"allowed\":{}}}",
+                    history.high_water().sequence,
+                    history.permits(
+                        a.credential.peer(),
+                        a.credential.key_epoch(),
+                        a.credential.member_epoch(),
+                        now()
+                    )
+                );
+            }
+        }
+        "serve" => {
+            let service = LanReadCandidate::from_owner_file(
+                f.trust,
+                File::open(directory.join("approved.txt"))?,
+                f.log("policy"),
+            )
+            .map_err(|e| format!("enroll file {e:?}"))?;
+            // A lab binary must never accidentally expose public fixture keys
+            // on a LAN/public interface. Separate processes use real TCP/TLS.
+            let address: std::net::SocketAddr = args
+                .get(3)
+                .map(String::as_str)
+                .unwrap_or("127.0.0.1:0")
+                .parse()?;
+            if !address.ip().is_loopback()
+                && std::env::var("LOOM_L002_ISOLATED_LAB").as_deref() != Ok("1")
+            {
+                return Err(
+                    "nonloopback fixture listener requires explicitly isolated laboratory".into(),
+                );
+            }
+            let listener = TcpListener::bind(address).await?;
+            println!(
+                "{{\"listen\":\"{}\",\"snapshot\":\"{}\"}}",
+                listener.local_addr()?,
+                hex(&service.snapshot_digest())
+            );
+            io::stdout().flush()?;
+            let (tcp, _) = timeout(Duration::from_secs(15), listener.accept()).await??;
+            let mut channel = timeout(
+                Duration::from_secs(10),
+                accept(tcp, b.identity(), a.context(), &a.verifier),
+            )
+            .await?
+            .map_err(|e| format!("TLS {e:?}"))?;
+            let mut session = None;
+            // Bounded one-client pull protocol, no remotely supplied paths,
+            // grants, offsets or policy mutations. This is NOT frozen wire.
+            for _ in 0..1024 {
+                let op =
+                    match timeout(Duration::from_secs(10), channel.stream_mut().read_u8()).await? {
+                        Ok(x) => x,
+                        Err(_) => break,
+                    };
+                let response = match op {
+                    1 => {
+                        let mut id = [0; 16];
+                        channel.stream_mut().read_exact(&mut id).await?;
+                        match service.open_read(
+                            &channel,
+                            &a.credential,
+                            &a.verifier,
+                            loom_types::ResourceId::from_bytes(id),
+                            |c| f.replies(c),
+                        ) {
+                            Ok(s) => {
+                                session = Some(s);
+                                Ok(Vec::new())
+                            }
+                            Err(e) => Err(e),
+                        }
+                    }
+                    2 => {
+                        let size = channel.stream_mut().read_u16().await? as usize;
+                        match session.as_mut() {
+                            Some(s) => service.read_chunk(
+                                s,
+                                &channel,
+                                &a.credential,
+                                &a.verifier,
+                                size,
+                                |c| f.replies(c),
+                            ),
+                            None => Err(ReadError::Denied),
+                        }
+                    }
+                    _ => Err(ReadError::InvalidInput),
+                };
+                match response {
+                    Ok(bytes) => {
+                        channel.stream_mut().write_u8(0).await?;
+                        channel.stream_mut().write_u16(bytes.len() as u16).await?;
+                        channel.stream_mut().write_all(&bytes).await?;
+                    }
+                    Err(e) => {
+                        println!("{{\"refusal\":\"{e:?}\"}}");
+                        io::stdout().flush()?;
+                        channel.stream_mut().write_u8(1).await?;
+                        channel.stream_mut().write_u16(0).await?;
+                    }
+                }
+            }
+        }
+        "client" => {
+            let address: std::net::SocketAddr = args.get(3).ok_or("address required")?.parse()?;
+            if !address.ip().is_loopback()
+                && std::env::var("LOOM_L002_ISOLATED_LAB").as_deref() != Ok("1")
+            {
+                return Err("lab supports loopback only".into());
+            }
+            let mut channel = timeout(
+                Duration::from_secs(10),
+                connect(
+                    TcpStream::connect(address).await?,
+                    a.identity(),
+                    b.context(),
+                    &b.verifier,
+                ),
+            )
+            .await?
+            .map_err(|e| format!("TLS {e:?}"))?;
+            let mut line = String::new();
+            loop {
+                line.clear();
+                if io::stdin().read_line(&mut line)? == 0 {
+                    break;
+                }
+                let words: Vec<_> = line.split_whitespace().collect();
+                match words.as_slice() {
+                    ["open"] => {
+                        channel.stream_mut().write_u8(1).await?;
+                        channel
+                            .stream_mut()
+                            .write_all(resource().as_bytes())
+                            .await?;
+                    }
+                    ["wrong-resource"] => {
+                        channel.stream_mut().write_u8(1).await?;
+                        channel.stream_mut().write_all(&[0; 16]).await?;
+                    }
+                    ["write"] => {
+                        channel.stream_mut().write_u8(3).await?;
+                    }
+                    ["read", size] => {
+                        channel.stream_mut().write_u8(2).await?;
+                        channel.stream_mut().write_u16(size.parse()?).await?;
+                    }
+                    _ => return Err("invalid client command".into()),
+                }
+                let status =
+                    timeout(Duration::from_secs(10), channel.stream_mut().read_u8()).await??;
+                let len = channel.stream_mut().read_u16().await? as usize;
+                if len > MAX_CHUNK_BYTES {
+                    return Err("oversize server reply".into());
+                }
+                let mut bytes = vec![0; len];
+                channel.stream_mut().read_exact(&mut bytes).await?;
+                println!(
+                    "{{\"ok\":{},\"bytes_hex\":\"{}\"}}",
+                    status == 0,
+                    hex(&bytes)
+                );
+                io::stdout().flush()?;
+            }
+            channel.stream_mut().shutdown().await?;
+        }
+        _ => return Err("unknown mode".into()),
+    }
+    Ok(())
+}
+fn hex(bytes: &[u8]) -> String {
+    bytes.iter().map(|b| format!("{b:02x}")).collect()
+}
diff --git a/crates/loom-core/examples/support/l002_fixture.rs b/crates/loom-core/examples/support/l002_fixture.rs
new file mode 100644
index 0000000..ac9d185
--- /dev/null
+++ b/crates/loom-core/examples/support/l002_fixture.rs
@@ -0,0 +1,230 @@
+//! Deliberately public fixture keys, used ONLY by tests and the lab executable.
+use ed25519_dalek::{Signer, SigningKey};
+use loom_crypto::{membership::*, owner_authority::issuer_key_id, space_trust::*};
+use loom_identity::signed_membership::SignedMembershipVerifier;
+use loom_store::{challenge_witness_quorum::*, witness_append::*};
+use loom_transport::secure_channel::*;
+use loom_types::{ResourceId, SpaceId};
+use loom_wire::security_event::*;
+use rcgen::{CertificateParams, KeyPair, PKCS_ED25519};
+use std::{
+    fs,
+    path::{Path, PathBuf},
+    time::{SystemTime, UNIX_EPOCH},
+};
+use tokio_rustls::rustls::pki_types::{CertificateDer, PrivateKeyDer};
+
+pub fn now() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap()
+        .as_millis()
+        .try_into()
+        .unwrap()
+}
+pub fn space() -> SpaceId {
+    SpaceId::from_bytes([101; 16])
+}
+pub fn resource() -> ResourceId {
+    ResourceId::from_bytes([102; 16])
+}
+pub const CONTENT: &[u8] = b"LOOM-L002-PRIVATE-FILE-CANARY\nowner approved snapshot\n";
+pub type LabResult<T> = Result<T, Box<dyn std::error::Error>>;
+
+pub struct Fixture {
+    pub directory: PathBuf,
+    pub trust: VerifiedResourceTrust,
+    pub owner: SigningKey,
+    pub witness_keys: [SigningKey; 2],
+    pub start: u64,
+}
+impl Fixture {
+    pub fn enroll(directory: &Path) -> LabResult<Self> {
+        fs::create_dir(directory)?;
+        fs::write(directory.join("start"), (now() - 1000).to_string())?;
+        for name in ["a", "b"] {
+            let key = KeyPair::generate_for(&PKCS_ED25519)?;
+            let cert = CertificateParams::new(vec!["loom-peer.local".into()])?.self_signed(&key)?;
+            fs::write(directory.join(format!("{name}.pem")), key.serialize_pem())?;
+            fs::write(directory.join(format!("{name}.der")), cert.der())?;
+        }
+        fs::write(directory.join("approved.txt"), CONTENT)?;
+        let f = Self::load(directory)?;
+        for name in ["policy", "witness-a", "witness-b"] {
+            WitnessLog::create(&f.path(name), f.trust).map_err(|e| format!("create {e:?}"))?;
+        }
+        Ok(f)
+    }
+    pub fn load(directory: &Path) -> LabResult<Self> {
+        let start = fs::read_to_string(directory.join("start"))?.parse::<u64>()?;
+        let root = SigningKey::from_bytes(&[111; 32]);
+        let owner = SigningKey::from_bytes(&[112; 32]);
+        let witness_keys = [113, 114].map(|v| SigningKey::from_bytes(&[v; 32]));
+        let manifest = ResourceTrustManifest {
+            space: space(),
+            resource: resource(),
+            owner_public_key: owner.verifying_key().to_bytes(),
+            owner_key_epoch: 2,
+            witness_public_keys: witness_keys
+                .each_ref()
+                .map(|k| k.verifying_key().to_bytes()),
+            writer_epoch: 3,
+            root_key_epoch: 1,
+            issued_at_ms: start,
+            expires_at_ms: start + 3_600_000,
+        };
+        let trust = verify_resource_trust_for_spike(
+            &ExternallyPinnedRootForSpike {
+                space: space(),
+                public_key: root.verifying_key().to_bytes(),
+                key_epoch: 1,
+            },
+            &SignedResourceTrust {
+                manifest,
+                signature: root.sign(&trust_manifest_transcript(&manifest)).to_bytes(),
+            },
+            now(),
+        )
+        .map_err(|e| format!("trust {e:?}"))?;
+        Ok(Self {
+            directory: directory.into(),
+            trust,
+            owner,
+            witness_keys,
+            start,
+        })
+    }
+    pub fn path(&self, name: &str) -> PathBuf {
+        self.directory.join(format!("{name}.sqlite"))
+    }
+    pub fn log(&self, name: &str) -> WitnessLog {
+        WitnessLog::open(&self.path(name), self.trust).unwrap()
+    }
+    pub fn signed(&self, history: &WitnessHistory, peer: &Peer, allow: bool) -> SignedAppend {
+        let request = AppendRequest {
+            manifest: self.trust.manifest_commitment(),
+            expected_generation: history.high_water().sequence,
+            previous_head: history.high_water().policy_head,
+            mutation: ReadMutation {
+                peer: peer.credential.peer(),
+                key_epoch: peer.credential.key_epoch(),
+                member_epoch: peer.credential.member_epoch(),
+                allow,
+            },
+            issued_at_ms: self.start,
+            expires_at_ms: self.start + 3_600_000,
+        };
+        SignedAppend {
+            request,
+            owner_signature: self.owner.sign(&append_transcript(&request)).to_bytes(),
+        }
+    }
+    pub fn commit_all(&self, peer: &Peer, allow: bool) -> SignedAppend {
+        let history = self.log("policy").history().unwrap();
+        let signed = self.signed(&history, peer, allow);
+        for name in ["policy", "witness-a", "witness-b"] {
+            self.log(name).append(signed, now()).unwrap();
+        }
+        signed
+    }
+    pub fn replies(
+        &self,
+        challenge: QuorumChallenge,
+    ) -> Result<Vec<SignedQuorumObservation>, loom_core::lan_read::ReadError> {
+        ["witness-a", "witness-b"]
+            .into_iter()
+            .enumerate()
+            .map(|(i, name)| {
+                WitnessLog::open(&self.path(name), self.trust)
+                    .and_then(|mut l| l.observe(&self.witness_keys[i], challenge, now()))
+                    .map_err(|_| loom_core::lan_read::ReadError::Quorum)
+            })
+            .collect()
+    }
+    pub fn peer(&self, name: &str) -> Peer {
+        self.peer_at_epochs(name, 5, 6)
+    }
+    pub fn peer_at_epochs(&self, name: &str, key_epoch: u64, member_epoch: u64) -> Peer {
+        let key = KeyPair::from_pem(
+            &fs::read_to_string(self.directory.join(format!("{name}.pem"))).unwrap(),
+        )
+        .unwrap();
+        let cert = fs::read(self.directory.join(format!("{name}.der")))
+            .unwrap()
+            .into();
+        let root = SigningKey::from_bytes(&[111; 32]);
+        let writer = SigningKey::from_bytes(&[115; 32]);
+        let delegation = MembershipWriterDelegation {
+            space: space(),
+            root_epoch: 1,
+            writer_public_key: writer.verifying_key().to_bytes(),
+            writer_epoch: 4,
+            issued_at_ms: self.start,
+            expires_at_ms: self.start + 3_600_000,
+        };
+        let event = CanonicalSecurityEvent {
+            kind: EventKind::MembershipGrant,
+            space_id: *space().as_bytes(),
+            signer_key_id: issuer_key_id(&delegation.writer_public_key),
+            issuer_epoch: 4,
+            issued_at_ms: self.start,
+            expires_at_ms: self.start + 3_600_000,
+            seq: 1,
+            payload: membership_payload(
+                key.public_key_raw().try_into().unwrap(),
+                key_epoch,
+                member_epoch,
+            ),
+        };
+        let bytes = encode_security_event(&event).unwrap();
+        let credential = verify_membership(
+            &ExternallyPinnedRootForSpike {
+                space: space(),
+                public_key: root.verifying_key().to_bytes(),
+                key_epoch: 1,
+            },
+            &SignedMembershipWriter {
+                delegation,
+                root_signature: root
+                    .sign(&membership_writer_transcript(&delegation))
+                    .to_bytes(),
+            },
+            MembershipRequirements {
+                writer_epoch: 4,
+                sequence: 1,
+            },
+            &bytes,
+            &writer.sign(&signing_input(&bytes).unwrap()).to_bytes(),
+            now(),
+        )
+        .unwrap();
+        Peer {
+            cert,
+            key: key.serialize_der(),
+            credential,
+            verifier: SignedMembershipVerifier::new(credential),
+        }
+    }
+}
+pub struct Peer {
+    pub cert: CertificateDer<'static>,
+    pub key: Vec<u8>,
+    pub credential: VerifiedMembership,
+    pub verifier: SignedMembershipVerifier,
+}
+impl Peer {
+    pub fn identity(&self) -> LocalTlsIdentity {
+        LocalTlsIdentity {
+            certificate: self.cert.clone(),
+            private_key: PrivateKeyDer::Pkcs8(self.key.clone().into()),
+            key_epoch: self.credential.key_epoch(),
+        }
+    }
+    pub fn context(&self) -> SecurePeerContext {
+        SecurePeerContext {
+            expected_remote: PinnedPeer::new(self.cert.clone(), self.credential.key_epoch())
+                .unwrap(),
+            space_id: space(),
+        }
+    }
+}
diff --git a/crates/loom-core/src/lan_read.rs b/crates/loom-core/src/lan_read.rs
new file mode 100644
index 0000000..57f4345
--- /dev/null
+++ b/crates/loom-core/src/lan_read.rs
@@ -0,0 +1,292 @@
+//! Opt-in L-002 LAN read laboratory with actual Owner-approved file snapshots.
+//!
+//! No path crosses the protocol: enrollment consumes an already-open regular
+//! file and freezes at most 1 MiB. Later path/symlink changes cannot redirect
+//! reads. A new file snapshot requires separate Owner enrollment. This module
+//! does NOT provide production ServiceOpen or independently durable enrollment.
+
+use loom_crypto::{membership::VerifiedMembership, space_trust::VerifiedResourceTrust};
+use loom_identity::{PeerPrincipal, signed_membership::SignedMembershipVerifier};
+use loom_store::{
+    challenge_witness_quorum::{
+        PinnedQuorum, QuorumChallenge, SignedQuorumObservation, verify_challenge_bound_quorum,
+    },
+    witness_append::{SignedAppend, WitnessHistory, WitnessLog},
+};
+use loom_transport::secure_channel::SecurePeerChannel;
+use loom_types::ResourceId;
+use sha2::{Digest, Sha256};
+use std::{
+    fs::File,
+    io::{Read, Seek, SeekFrom},
+    sync::Mutex,
+    time::{SystemTime, UNIX_EPOCH},
+};
+
+pub const MAX_FILE_BYTES: usize = 1024 * 1024;
+pub const MAX_CHUNK_BYTES: usize = 4096;
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum ReadError {
+    Denied,
+    Stale,
+    Storage,
+    InvalidInput,
+    Quorum,
+    Membership,
+    Clock,
+}
+
+/// A process-local session, invalidated by EVERY policy change, including a
+/// revoke followed by re-grant. Never serialized as a durable admission token.
+#[derive(Debug)]
+pub struct ReadSession {
+    principal: PeerPrincipal,
+    key_epoch: u64,
+    head: [u8; 32],
+    snapshot: [u8; 32],
+    offset: usize,
+}
+
+pub struct LanReadCandidate {
+    trust: VerifiedResourceTrust,
+    bytes: Vec<u8>,
+    digest: [u8; 32],
+    journal: Mutex<WitnessLog>,
+}
+
+fn now_ms() -> Result<u64, ReadError> {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_err(|_| ReadError::Clock)?
+        .as_millis()
+        .try_into()
+        .map_err(|_| ReadError::Clock)
+}
+
+impl LanReadCandidate {
+    /// Local Owner supplies the capability, NEVER a received path. The handle
+    /// must have been safely selected by a trusted enrollment workflow. Snapshot
+    /// enrollment while another local writer edits the file is not supported.
+    pub fn from_owner_file(
+        trust: VerifiedResourceTrust,
+        mut file: File,
+        journal: WitnessLog,
+    ) -> Result<Self, ReadError> {
+        if journal.manifest_commitment() != trust.manifest_commitment() {
+            return Err(ReadError::Storage);
+        }
+        let metadata = file.metadata().map_err(|_| ReadError::Storage)?;
+        if !metadata.is_file() || metadata.len() > MAX_FILE_BYTES as u64 {
+            return Err(ReadError::InvalidInput);
+        }
+        let mut bytes = Vec::new();
+        file.seek(SeekFrom::Start(0))
+            .map_err(|_| ReadError::Storage)?;
+        file.by_ref()
+            .take(MAX_FILE_BYTES as u64 + 1)
+            .read_to_end(&mut bytes)
+            .map_err(|_| ReadError::Storage)?;
+        if bytes.len() > MAX_FILE_BYTES || bytes.len() as u64 != metadata.len() {
+            return Err(ReadError::InvalidInput);
+        }
+        let digest = Sha256::digest(&bytes).into();
+        Ok(Self {
+            trust,
+            bytes,
+            digest,
+            journal: Mutex::new(journal),
+        })
+    }
+
+    pub fn snapshot_digest(&self) -> [u8; 32] {
+        self.digest
+    }
+
+    /// Local signed policy commits share the read barrier. No network call is
+    /// made under this lock. A partial remote quorum never authorizes a read.
+    pub fn commit(&self, signed: SignedAppend) -> Result<WitnessHistory, ReadError> {
+        signed
+            .verify_history(&self.trust)
+            .map_err(|_| ReadError::Denied)?;
+        self.journal
+            .lock()
+            .map_err(|_| ReadError::Storage)?
+            .append(signed, now_ms()?)
+            .map_err(|_| ReadError::Storage)
+    }
+
+    fn history(&self) -> Result<WitnessHistory, ReadError> {
+        let records = self
+            .journal
+            .lock()
+            .map_err(|_| ReadError::Storage)?
+            .history()
+            .map_err(|_| ReadError::Storage)?
+            .into_records();
+        // Re-verify against THIS resource's root, even if the supplied SQLite
+        // handle was enrolled for a different manifest.
+        WitnessHistory::verify(&self.trust, records).map_err(|_| ReadError::Storage)
+    }
+
+    fn check_channel<S>(
+        &self,
+        channel: &SecurePeerChannel<S>,
+        member: &VerifiedMembership,
+        verifier: &SignedMembershipVerifier,
+    ) -> Result<(), ReadError> {
+        channel
+            .revalidate_membership(verifier)
+            .map_err(|_| ReadError::Membership)?;
+        let principal = channel.remote_principal();
+        if !member.valid_at(now_ms()?)
+            || member.root_identity() != (self.trust.root_public_key(), self.trust.root_key_epoch())
+            || member.space() != self.trust.space()
+            || principal.peer_id != member.peer()
+            || channel.remote_key_epoch() != member.key_epoch()
+            || principal.space_id != member.space()
+            || principal.membership_epoch != member.member_epoch()
+        {
+            return Err(ReadError::Membership);
+        }
+        Ok(())
+    }
+
+    /// Fetch runs without a SQLite transaction or resource lock. The nonce is
+    /// created here by OS CSPRNG and lives for this one call only. Every open
+    /// and chunk requires two fresh responses; timeout/offline is fail-closed.
+    fn fresh_history<F>(&self, fetch: F) -> Result<WitnessHistory, ReadError>
+    where
+        F: FnOnce(QuorumChallenge) -> Result<Vec<SignedQuorumObservation>, ReadError>,
+    {
+        let history = self.history()?;
+        let mut nonce = [0; 32];
+        getrandom::getrandom(&mut nonce).map_err(|_| ReadError::Quorum)?;
+        let challenge = QuorumChallenge {
+            nonce,
+            expected_space: self.trust.space(),
+            expected_resource: self.trust.resource(),
+            expected_writer_epoch: self.trust.writer_epoch(),
+        };
+        let replies = fetch(challenge)?;
+        verify_challenge_bound_quorum(
+            &PinnedQuorum {
+                witnesses: self.trust.witnesses(),
+                space: self.trust.space(),
+                resource: self.trust.resource(),
+                writer_epoch: self.trust.writer_epoch(),
+            },
+            challenge,
+            &replies,
+            history.high_water().sequence,
+            history.high_water(),
+        )
+        .map_err(|_| ReadError::Quorum)?;
+        Ok(history)
+    }
+
+    pub fn open_read<S, F>(
+        &self,
+        channel: &SecurePeerChannel<S>,
+        member: &VerifiedMembership,
+        verifier: &SignedMembershipVerifier,
+        resource: ResourceId,
+        fetch: F,
+    ) -> Result<ReadSession, ReadError>
+    where
+        F: FnOnce(QuorumChallenge) -> Result<Vec<SignedQuorumObservation>, ReadError>,
+    {
+        if resource != self.trust.resource() {
+            return Err(ReadError::Denied);
+        }
+        self.check_channel(channel, member, verifier)?;
+        let history = self.fresh_history(fetch)?;
+        let mut journal = self.journal.lock().map_err(|_| ReadError::Storage)?;
+        self.check_channel(channel, member, verifier)?;
+        journal
+            .inspect(|current| {
+                Ok((|| {
+                    if current.high_water() != history.high_water() {
+                        return Err(ReadError::Stale);
+                    }
+                    if !self.trust.valid_at(now_ms()?)
+                        || !history.permits(
+                            member.peer(),
+                            member.key_epoch(),
+                            member.member_epoch(),
+                            now_ms()?,
+                        )
+                    {
+                        return Err(ReadError::Denied);
+                    }
+                    Ok(ReadSession {
+                        principal: *channel.remote_principal(),
+                        key_epoch: member.key_epoch(),
+                        head: history.high_water().policy_head,
+                        snapshot: self.digest,
+                        offset: 0,
+                    })
+                })())
+            })
+            .map_err(|_| ReadError::Storage)?
+    }
+
+    /// Linearization boundary is copying this bounded chunk under the local
+    /// commit barrier. Bytes copied before a revoke can remain in TLS/kernel
+    /// buffers; a revocation cannot recall bytes already released.
+    pub fn read_chunk<S, F>(
+        &self,
+        session: &mut ReadSession,
+        channel: &SecurePeerChannel<S>,
+        member: &VerifiedMembership,
+        verifier: &SignedMembershipVerifier,
+        size: usize,
+        fetch: F,
+    ) -> Result<Vec<u8>, ReadError>
+    where
+        F: FnOnce(QuorumChallenge) -> Result<Vec<SignedQuorumObservation>, ReadError>,
+    {
+        if size == 0 || size > MAX_CHUNK_BYTES {
+            return Err(ReadError::InvalidInput);
+        }
+        self.check_channel(channel, member, verifier)?;
+        if session.principal != *channel.remote_principal()
+            || session.key_epoch != member.key_epoch()
+            || session.snapshot != self.digest
+        {
+            return Err(ReadError::Stale);
+        }
+        let history = self.fresh_history(fetch)?;
+        let mut journal = self.journal.lock().map_err(|_| ReadError::Storage)?;
+        self.check_channel(channel, member, verifier)?;
+        journal
+            .inspect(|current| {
+                Ok((|| {
+                    if current.high_water() != history.high_water()
+                        || session.head != current.high_water().policy_head
+                    {
+                        return Err(ReadError::Stale);
+                    }
+                    if !self.trust.valid_at(now_ms()?)
+                        || !history.permits(
+                            member.peer(),
+                            member.key_epoch(),
+                            member.member_epoch(),
+                            now_ms()?,
+                        )
+                    {
+                        return Err(ReadError::Denied);
+                    }
+                    let end = session.offset.saturating_add(size).min(self.bytes.len());
+                    let bytes = self
+                        .bytes
+                        .get(session.offset..end)
+                        .ok_or(ReadError::Stale)?
+                        .to_vec();
+                    session.offset = end;
+                    Ok(bytes)
+                })())
+            })
+            .map_err(|_| ReadError::Storage)?
+    }
+}
